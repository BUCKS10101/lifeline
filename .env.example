# Copy to .env for local overrides. Never commit real secrets.

# Database
DB_URL=jdbc:postgresql://localhost:5432/personal_os
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis (used by Spring Session). Blank password and disabled TLS match the local Docker Redis, which has neither.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Server-side URL of the Spring Boot backend (used by Next.js rewrites and server components)
BACKEND_URL=http://localhost:8080
# Public URL of the Next.js frontend (used in verification/reset-password email links)
FRONTEND_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API with credentials (no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# The port the backend listens on. Hosting platforms (e.g. Render) set this themselves; leave unset locally for 8080.
PORT=8080

# Set to true only behind HTTPS (production). Must stay false for local HTTP development.
SESSION_COOKIE_SECURE=false

# Email. MAIL_PROVIDER selects how it's sent: "smtp" (default, local Mailhog, below) or "resend" (production,
# Resend's HTTP API over HTTPS — needed because some hosts, e.g. Render's free tier, block outbound SMTP ports).
MAIL_FROM=no-reply@personal-os.local
MAIL_PROVIDER=smtp
# Only used when MAIL_PROVIDER=resend. Never commit the real key here.
RESEND_API_KEY=

# SMTP settings, only used when MAIL_PROVIDER=smtp. Defaults match the local Mailhog container exactly.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_SSL_ENABLE=false
